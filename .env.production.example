# Production Environment Configuration for AWS
# Copy this file to .env on your EC2 instance and update with actual values

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://ambersand_admin:YOUR_DB_PASSWORD@your-rds-endpoint.rds.amazonaws.com:5432/ambersand

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production
PORT=5000
APP_BASE_URL=https://yourdomain.com

# ============================================
# JWT Authentication Secrets
# ============================================
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING

# Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_32_CHAR_HEX_STRING

# ============================================
# Email Configuration
# ============================================
EMAIL_DRIVER=sendgrid

# SendGrid Configuration
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
SENDGRID_FROM_NAME=Ambersand

# Alternative: SMTP Configuration (if not using SendGrid)
# EMAIL_DRIVER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM_EMAIL=no-reply@yourdomain.com
# SMTP_FROM_NAME=Ambersand

# ============================================
# AWS Configuration
# ============================================
AWS_REGION=us-east-1
AWS_S3_BUCKET=ambersand-uploads-prod

# Note: AWS credentials are provided by IAM instance role
# DO NOT set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here

# ============================================
# Optional: Replit Auth (Legacy - can be removed)
# ============================================
# REPL_ID=
# REPLIT_DOMAINS=
# ISSUER_URL=

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info

# ============================================
# Security Notes
# ============================================
# 1. NEVER commit this file with real secrets to version control
# 2. Set file permissions: chmod 600 .env
# 3. Rotate secrets regularly (every 90 days recommended)
# 4. Use AWS Secrets Manager for production (optional but recommended)
# 5. Enable AWS CloudWatch for application logging
