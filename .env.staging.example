# Staging Environment Configuration for AWS
# Copy this file to .env on your staging EC2 instance

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://ambersand_admin:YOUR_DB_PASSWORD@your-staging-rds-endpoint.rds.amazonaws.com:5432/ambersand_staging

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production
PORT=5000
APP_BASE_URL=https://staging.yourdomain.com

# ============================================
# JWT Authentication Secrets
# ============================================
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=STAGING_REPLACE_WITH_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=STAGING_REPLACE_WITH_64_CHAR_HEX_STRING
SESSION_SECRET=STAGING_REPLACE_WITH_32_CHAR_HEX_STRING

# ============================================
# Email Configuration (Use test mode for staging)
# ============================================
EMAIL_DRIVER=sendgrid
SENDGRID_API_KEY=SG.staging_api_key
SENDGRID_FROM_EMAIL=staging-no-reply@yourdomain.com
SENDGRID_FROM_NAME=Ambersand Staging

# ============================================
# AWS Configuration
# ============================================
AWS_REGION=us-east-1
AWS_S3_BUCKET=ambersand-uploads-staging

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=debug
