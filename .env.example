# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ambersand

# Email Configuration
# Choose driver: "sendgrid" (default) or "smtp"
EMAIL_DRIVER=sendgrid

# SendGrid Configuration (required when EMAIL_DRIVER=sendgrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
SENDGRID_FROM_NAME=Ambersand

# SMTP Configuration (required when EMAIL_DRIVER=smtp)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM_EMAIL=no-reply@yourdomain.com
# SMTP_FROM_NAME=Ambersand

# Application
APP_BASE_URL=http://localhost:5000
NODE_ENV=development

# JWT Secrets (REQUIRED - generate secure random strings)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_very_long_random_access_secret_here_min_64_chars
JWT_REFRESH_SECRET=your_very_long_random_refresh_secret_here_min_64_chars

# Session Secret (for Replit Auth - if still using)
SESSION_SECRET=your_session_secret_here

# Replit Auth (if still using)
# REPL_ID=your_repl_id
# REPLIT_DOMAINS=your-domain.replit.dev
# ISSUER_URL=https://replit.com/oidc
